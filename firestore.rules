rules_version = '2';

// IMPORTANT — les règles Firestore se combinent en OU : il n'existe pas de refus,
// seulement des autorisations. Un « allow write: if false » n'interdit donc rien si
// un autre bloc accorde l'écriture. C'est pourquoi il n'y a PLUS de règle d'écriture
// récursive ici : les écritures sont accordées collection par collection.
//
// => Si tu ajoutes une collection gérée depuis l'admin, ajoute-lui son bloc
//    « allow write: if isAdmin(); » ci-dessous, sinon l'admin ne pourra pas y écrire.
//    La LECTURE admin, elle, reste récursive : rien à faire pour les nouvelles collections.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- LISTE DES ADMINS ---

    // Volontairement en lecture seule pour TOUS les clients, admins compris :
    // aucune règle d'écriture ne correspond à ce chemin, donc promouvoir ou
    // retirer un admin ne peut se faire que depuis la console Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // --- LECTURE ADMIN (RÉCURSIVE) ---

    // Un admin peut tout lire, y compris les futures collections.
    // Les écritures sont accordées explicitement plus bas, jamais ici.
    match /{document=**} {
      allow read: if isAdmin();
    }

    // --- CONTENU DU SITE (LECTURE PUBLIQUE, ÉCRITURE ADMIN) ---

    match /monthly_verse/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /program_overrides/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- NEWSLETTER ---

    // L'identifiant du document est l'adresse email en minuscules, donc n'importe qui
    // connaissant une adresse peut viser son document : create et update sont limités
    // aux champs que le site écrit réellement.
    match /newsletter/{email} {
      allow get: if true;                 // vérifier une adresse précise (lister reste réservé à l'admin)
      allow write: if isAdmin();

      // Abonnement depuis le site ou le pied de page.
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email == email
                    && request.resource.data.source is string;

      // Désabonnement / réabonnement : rien d'autre que l'indicateur de statut.
      allow update: if changedKeys().hasOnly(['unsubscribed', 'updatedAt'])
                    && request.resource.data.unsubscribed is bool;
    }

    // --- CARTE DES ÉGLISES ---

    match /churches/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      // Bouton « j'aime » public : un seul champ, un seul cran à la fois.
      allow update: if changedKeys().hasOnly(['likes'])
                    && request.resource.data.likes is int
                    && request.resource.data.likes >= 0
                    && (request.resource.data.likes == resource.data.get('likes', 0) + 1
                        || request.resource.data.likes == resource.data.get('likes', 0) - 1);
    }

    match /church_suggestions/{docId} {
      allow write: if isAdmin();

      // Proposition publique : uniquement les champs du formulaire, et toujours
      // « pending » — impossible de déposer une suggestion déjà approuvée.
      //
      // Ces documents contiennent les coordonnées de la personne qui propose.
      // expiresAt est obligatoire pour que la suppression automatique soit
      // possible le jour où on la voudra — mais AUCUNE règle TTL n'est active
      // sur cette collection (choix assumé du 31/08/2026) : la date est écrite,
      // rien ne l'exploite, et les propositions se suppriment à la main depuis
      // l'admin. Ne pas lire ce champ comme une garantie d'effacement.
      //
      // Le plafond sur le nombre de clés, lui, empêche d'y déverser une charge
      // arbitraire, et il est bien actif.
      allow create: if request.resource.data.keys().hasOnly(['type', 'originalChurchId', 'status', 'data', 'createdAt', 'expiresAt'])
                    && request.resource.data.keys().hasAll(['type', 'status', 'data', 'createdAt', 'expiresAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.type in ['new', 'edit']
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.data is map
                    && request.resource.data.data.keys().size() <= 20;
    }

    // --- STATISTIQUES AGRÉGÉES ---

    // Un document par jour, contenant uniquement des compteurs. Aucune ligne
    // individuelle, aucun identifiant de visiteur, aucune coordonnée : il est
    // impossible de savoir qui est venu, ni de relier deux visites entre elles.
    // C'est ce qui rend ces données anonymes, donc conservables sans limite de
    // durée et sans consentement — le même principe que Vercel Analytics.
    //
    // Ce qu'on ne peut PAS vérifier ici : les règles ne savent pas parcourir les
    // valeurs d'une map, donc rien n'empêche d'écrire { Belgium: 99999 }. Le
    // risque est de fausser un compteur, pas de lire ou d'extraire quoi que ce
    // soit — et il existait déjà avant, puisque n'importe qui pouvait créer des
    // visites fictives. Ce qui est vérifié : la forme, les types, et le fait que
    // les compteurs ne peuvent que croître.

    // Les compteurs du site et ceux de la carte sont séparés : la page
    // Statistiques propose les deux vues, et les mélanger les rendrait faux.
    function compteurValide(n) { return n is int && n >= 0; }
    function repartitionValide(m, maxCles) {
      return m is map && m.keys().size() <= maxCles;
    }
    // get(champ, défaut) et non d.champ : une visite du site n'écrit pas les
    // compteurs de la carte, et inversement. Lire un champ absent ferait échouer
    // toute l'évaluation, donc refuser la première visite de chaque journée.
    function compteursValides(d) {
      return compteurValide(d.get('visits', 0)) && compteurValide(d.get('mapVisits', 0))
        && repartitionValide(d.get('countries', {}), 300) && repartitionValide(d.get('cities', {}), 600)
        && repartitionValide(d.get('devices', {}), 10) && repartitionValide(d.get('languages', {}), 50)
        && repartitionValide(d.get('mapCountries', {}), 300) && repartitionValide(d.get('mapCities', {}), 600)
        && repartitionValide(d.get('mapDevices', {}), 10) && repartitionValide(d.get('mapLanguages', {}), 50)
        && repartitionValide(d.get('mapGeo', {}), 10);
    }

    // Une visite ne fait grandir chaque répartition que d'une clé au plus.
    function croissanceRaisonnable(avant, apres, cle) {
      return apres.get(cle, {}).keys().size() <= avant.get(cle, {}).keys().size() + 1;
    }

    match /stats_daily/{jour} {
      allow read: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['day', 'visits', 'countries', 'cities', 'devices', 'languages',
                          'mapVisits', 'mapCountries', 'mapCities', 'mapDevices', 'mapLanguages', 'mapGeo'])
                    && request.resource.data.day == jour
                    && jour.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
                    && compteursValides(request.resource.data)
                    // Une création ne peut compter qu'une seule visite.
                    && request.resource.data.get('visits', 0) <= 1
                    && request.resource.data.get('mapVisits', 0) <= 1;

      allow update: if request.resource.data.keys().hasOnly(['day', 'visits', 'countries', 'cities', 'devices', 'languages',
                          'mapVisits', 'mapCountries', 'mapCities', 'mapDevices', 'mapLanguages', 'mapGeo'])
                    && request.resource.data.day == resource.data.day
                    && compteursValides(request.resource.data)
                    // Un compteur ne redescend jamais, et n'avance que d'un cran.
                    && request.resource.data.get('visits', 0) >= resource.data.get('visits', 0)
                    && request.resource.data.get('visits', 0) <= resource.data.get('visits', 0) + 1
                    && request.resource.data.get('mapVisits', 0) >= resource.data.get('mapVisits', 0)
                    && request.resource.data.get('mapVisits', 0) <= resource.data.get('mapVisits', 0) + 1
                    && croissanceRaisonnable(resource.data, request.resource.data, 'countries')
                    && croissanceRaisonnable(resource.data, request.resource.data, 'cities')
                    && croissanceRaisonnable(resource.data, request.resource.data, 'devices')
                    && croissanceRaisonnable(resource.data, request.resource.data, 'languages')
                    && croissanceRaisonnable(resource.data, request.resource.data, 'mapCountries')
                    && croissanceRaisonnable(resource.data, request.resource.data, 'mapCities')
                    && croissanceRaisonnable(resource.data, request.resource.data, 'mapDevices')
                    && croissanceRaisonnable(resource.data, request.resource.data, 'mapLanguages')
                    && croissanceRaisonnable(resource.data, request.resource.data, 'mapGeo');

      // Aucune règle de suppression : ces données sont anonymes, rien
      // n'oblige à les effacer, et personne ne doit pouvoir les perdre.
    }

    // Les collections visitors, map_visitors, visits_global et bot_visits ont été
    // retirées : le site ne conserve plus de ligne par visite, seulement les
    // compteurs de stats_daily. Aucune règle ne les mentionne, donc plus aucune
    // écriture n'y est possible — c'est volontaire.

  }
}
