rules_version = '2';

// IMPORTANT — les règles Firestore se combinent en OU : il n'existe pas de refus,
// seulement des autorisations. Un « allow write: if false » n'interdit donc rien si
// un autre bloc accorde l'écriture. C'est pourquoi il n'y a PLUS de règle d'écriture
// récursive ici : les écritures sont accordées collection par collection.
//
// => Si tu ajoutes une collection gérée depuis l'admin, ajoute-lui son bloc
//    « allow write: if isAdmin(); » ci-dessous, sinon l'admin ne pourra pas y écrire.
//    La LECTURE admin, elle, reste récursive : rien à faire pour les nouvelles collections.

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // --- LISTE DES ADMINS ---

    // Volontairement en lecture seule pour TOUS les clients, admins compris :
    // aucune règle d'écriture ne correspond à ce chemin, donc promouvoir ou
    // retirer un admin ne peut se faire que depuis la console Firebase.
    match /admins/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
    }

    // --- LECTURE ADMIN (RÉCURSIVE) ---

    // Un admin peut tout lire, y compris les futures collections.
    // Les écritures sont accordées explicitement plus bas, jamais ici.
    match /{document=**} {
      allow read: if isAdmin();
    }

    // --- CONTENU DU SITE (LECTURE PUBLIQUE, ÉCRITURE ADMIN) ---

    match /monthly_verse/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /events/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /program_overrides/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // --- NEWSLETTER ---

    // L'identifiant du document est l'adresse email en minuscules, donc n'importe qui
    // connaissant une adresse peut viser son document : create et update sont limités
    // aux champs que le site écrit réellement.
    match /newsletter/{email} {
      allow get: if true;                 // vérifier une adresse précise (lister reste réservé à l'admin)
      allow write: if isAdmin();

      // Abonnement depuis le site ou le pied de page.
      allow create: if request.resource.data.keys().hasOnly(['email', 'subscribedAt', 'source'])
                    && request.resource.data.email is string
                    && request.resource.data.email == email
                    && request.resource.data.source is string;

      // Désabonnement / réabonnement : rien d'autre que l'indicateur de statut.
      allow update: if changedKeys().hasOnly(['unsubscribed', 'updatedAt'])
                    && request.resource.data.unsubscribed is bool;
    }

    // --- CARTE DES ÉGLISES ---

    match /churches/{docId} {
      allow read: if true;
      allow write: if isAdmin();

      // Bouton « j'aime » public : un seul champ, un seul cran à la fois.
      allow update: if changedKeys().hasOnly(['likes'])
                    && request.resource.data.likes is int
                    && request.resource.data.likes >= 0
                    && (request.resource.data.likes == resource.data.get('likes', 0) + 1
                        || request.resource.data.likes == resource.data.get('likes', 0) - 1);
    }

    match /church_suggestions/{docId} {
      allow write: if isAdmin();

      // Proposition publique : uniquement les champs du formulaire, et toujours
      // « pending » — impossible de déposer une suggestion déjà approuvée.
      //
      // Ces documents contiennent les coordonnées de la personne qui propose.
      // expiresAt est obligatoire pour que la suppression automatique soit
      // possible le jour où on la voudra — mais AUCUNE règle TTL n'est active
      // sur cette collection (choix assumé du 31/08/2026) : la date est écrite,
      // rien ne l'exploite, et les propositions se suppriment à la main depuis
      // l'admin. Ne pas lire ce champ comme une garantie d'effacement.
      //
      // Le plafond sur le nombre de clés, lui, empêche d'y déverser une charge
      // arbitraire, et il est bien actif.
      allow create: if request.resource.data.keys().hasOnly(['type', 'originalChurchId', 'status', 'data', 'createdAt', 'expiresAt'])
                    && request.resource.data.keys().hasAll(['type', 'status', 'data', 'createdAt', 'expiresAt'])
                    && request.resource.data.status == 'pending'
                    && request.resource.data.type in ['new', 'edit']
                    && request.resource.data.expiresAt is timestamp
                    && request.resource.data.data is map
                    && request.resource.data.data.keys().size() <= 20;
    }

    // --- TRACKING ET STATS (CRÉATION PUBLIQUE) ---

    // Ces collections sont écrites par le navigateur des visiteurs : le compteur
    // ne fonctionne pas autrement. Elles acceptaient donc n'importe quoi, de
    // n'importe qui — des visites inventées pour fausser les chiffres, ou des
    // documents géants écrits en boucle pour gonfler la facture Firestore.
    //
    // Les fonctions ci-dessous décrivent exactement ce que le site écrit. Toute
    // évolution du compteur doit passer par elles, sinon l'écriture est refusée
    // en silence et le comptage s'arrête sans prévenir personne.

    function estTexteBorne(v, max) {
      return v is string && v.size() <= max;
    }

    // Champs communs aux trois collections de suivi.
    function suiviCommunValide(d, visitorId) {
      return estTexteBorne(d.visitorId, 64)
        && d.visitorId == visitorId          // pas d'écriture sous l'identifiant d'un autre
        && estTexteBorne(d.deviceType, 16)
        && d.deviceType in ['mobile', 'desktop', 'unknown']
        && estTexteBorne(d.language, 16)
        && estTexteBorne(d.country, 60)
        && estTexteBorne(d.city, 60)
        && d.expiresAt is timestamp;         // sans lui, la règle TTL n'efface rien
    }

    // Les chemins { path=** } sont nécessaires : les requêtes collectionGroup de la
    // page Statistiques ne sont autorisées que par une règle écrite sous cette forme.
    match /{path=**}/visitors/{visitorId} {
      allow read: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                         ['visitorId', 'day', 'timeHM', 'deviceType', 'language', 'country', 'city', 'expiresAt'])
                    && request.resource.data.keys().hasAll(
                         ['visitorId', 'day', 'timeHM', 'deviceType', 'language', 'country', 'city', 'expiresAt'])
                    && suiviCommunValide(request.resource.data, visitorId)
                    && estTexteBorne(request.resource.data.day, 12)
                    && estTexteBorne(request.resource.data.timeHM, 5);

      // Maintenance : l'admin peut poser la date d'expiration sur les documents
      // écrits avant l'introduction de la conservation limitée. Volontairement
      // restreint à ce seul champ — aucune donnée de visite n'est modifiable.
      allow update: if isAdmin() && changedKeys().hasOnly(['expiresAt']);
      // Purge RGPD depuis l'admin. Il n'existait aucune règle de suppression :
      // seule la règle TTL de Firestore effaçait, et c'est un mécanisme interne
      // qui ne passe pas par ces règles. L'effacement étant devenu manuel, il
      // faut cette porte — réservée à l'admin, et irréversible par nature.
      allow delete: if isAdmin();
    }

    // Écrit avec merge : request.resource.data porte le document fusionné, donc
    // la liste de clés doit couvrir les deux formes, avec et sans coordonnées.
    match /{path=**}/map_visitors/{visitorId} {
      allow read: if isAdmin();

      allow create, update: if request.resource.data.keys().hasOnly(
                                 ['visitorId', 'day', 'timeHM', 'deviceType', 'language', 'country', 'city',
                                  'geoStatus', 'timestamp', 'expiresAt', 'preciseLat', 'preciseLng'])
                            && request.resource.data.keys().hasAll(
                                 ['visitorId', 'day', 'timeHM', 'deviceType', 'language', 'country', 'city',
                                  'geoStatus', 'timestamp', 'expiresAt'])
                            && suiviCommunValide(request.resource.data, visitorId)
                            && estTexteBorne(request.resource.data.day, 12)
                            && estTexteBorne(request.resource.data.timeHM, 5)
                            && request.resource.data.geoStatus in ['initial', 'granted', 'denied']
                            && request.resource.data.timestamp is int
                            // Coordonnées facultatives : présentes seulement si le
                            // visiteur a autorisé la géolocalisation précise.
                            && (!('preciseLat' in request.resource.data.keys())
                                || (request.resource.data.preciseLat is number
                                    && request.resource.data.preciseLat >= -90
                                    && request.resource.data.preciseLat <= 90))
                            && (!('preciseLng' in request.resource.data.keys())
                                || (request.resource.data.preciseLng is number
                                    && request.resource.data.preciseLng >= -180
                                    && request.resource.data.preciseLng <= 180));
      // Purge RGPD depuis l'admin, comme pour /visitors.
      allow delete: if isAdmin();
    }

    match /visits_global/{visitorId} {
      allow read: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(
                         ['visitorId', 'firstDay', 'firstTimeHM', 'deviceType', 'language', 'country', 'city', 'expiresAt'])
                    && request.resource.data.keys().hasAll(
                         ['visitorId', 'firstDay', 'firstTimeHM', 'deviceType', 'language', 'country', 'city', 'expiresAt'])
                    && suiviCommunValide(request.resource.data, visitorId)
                    && estTexteBorne(request.resource.data.firstDay, 12)
                    && estTexteBorne(request.resource.data.firstTimeHM, 5);

      // Même restriction que pour /visitors : uniquement la date d'expiration.
      allow update: if isAdmin() && changedKeys().hasOnly(['expiresAt']);
      // Purge RGPD depuis l'admin. Il n'existait aucune règle de suppression :
      // seule la règle TTL de Firestore effaçait, et c'est un mécanisme interne
      // qui ne passe pas par ces règles. L'effacement étant devenu manuel, il
      // faut cette porte — réservée à l'admin, et irréversible par nature.
      allow delete: if isAdmin();
    }
  }
}
